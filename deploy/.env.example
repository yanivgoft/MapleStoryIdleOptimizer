# Copy to deploy/.env (git-ignored) and edit.  Values already exported in your shell win over this file.
# Nothing in here is a secret: the API is stateless and public.  Never put tokens/keys in this file.

# ---- Google Cloud / Cloud Run (deploy_api.sh) -------------------------------------------------------------
PROJECT_ID=your-gcp-project-id            # REQUIRED.  The project ID (not the name, not the number).
REGION=us-central1                        # Cloud Run region.  us-central1 / us-east1 / us-west1 are the regions the free tier is documented for
                                          # (verify at https://cloud.google.com/run/pricing before you rely on it).
SERVICE=msi-api                           # Cloud Run service name.

# Origins allowed to call the API from a browser (comma separated, no path, no trailing slash).  REQUIRED for a real deploy.
#   GitHub Pages:      https://<your-github-user>.github.io
#   Cloudflare Pages:  https://<project>.pages.dev
#   Firebase Hosting:  https://<project>.web.app,https://<project>.firebaseapp.com
CORS_ORIGINS=https://your-github-user.github.io

# Number of trusted proxies in front of the container, i.e. which X-Forwarded-For entry is the real client.  Cloud Run's own front end
# appends the connecting client's address, so 1 is expected - VERIFY it after the first deploy (deploy/README.md section 6), because it
# decides the per-IP rate limiter's key.  Never set it higher than the real number of proxies (spoofable); 0 = ignore the header.
PROXY_HOPS=1

# ---- Cost / safety knobs (defaults shown) -------------------------------------------------------------------
MAX_INSTANCES=2                           # hard cap on parallel containers = the main spending brake
MIN_INSTANCES=0                           # 0 = scale to zero (cold starts, but no idle charge).  Anything >0 is billed around the clock.
CONCURRENCY=10                            # requests handled at once per container (the engine is CPU bound, 1 worker, 1 vCPU)
CPU=1
MEMORY=512Mi
TIMEOUT=60                                # seconds per request
RATE_LIMIT_PER_MINUTE=120                 # MSI_RATE_LIMIT_PER_MINUTE (per client IP, per container instance, in memory)
LOG_LEVEL=INFO                            # MSI_LOG_LEVEL

# ---- Optional switches ---------------------------------------------------------------------------------------
ENABLE_APIS=0                             # 1 = run `gcloud services enable run/artifactregistry/cloudbuild` first (needs permission to enable APIs)
SMOKE=0                                   # 1 = run deploy/smoke_test.sh against the new URL after deploying
DRY_RUN=0                                 # 1 = stage + print the gcloud commands, call nothing

# ---- Front end (deploy_web.sh) ---------------------------------------------------------------------------------
# API_URL=https://msi-api-xxxxxxxx-uc.a.run.app   # optional: if empty, deploy_web.sh asks gcloud for the service URL
STATIC_HOST=github-pages                  # github-pages | cloudflare | firebase | none (build only)
# github-pages: path the site is served from.  Project site https://<user>.github.io/<repo>/ -> /<repo>/ ; custom domain or user site -> /
WEB_BASE=/MapleStoryIdleOptimizer/
# cloudflare:
# CF_PAGES_PROJECT=msi-dps                # needs `npx wrangler login` or CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID in the environment
# firebase:
# FIREBASE_PROJECT=your-firebase-project-id   # needs `npx firebase-tools login` (or GOOGLE_APPLICATION_CREDENTIALS)
# FIREBASE_DEPLOY_RULES=1                     # 1 (default) = firebase deploy --only hosting,firestore:rules ; 0 = hosting only (before the Firestore database exists)

# ---- Accounts (optional; Google sign-in + cloud-saved profiles) -----------------------------------------------------
# The Firebase web app's PUBLIC config (Firebase console -> Project settings -> Your apps -> Web app).  Baked into the front end at build time.
# All four or none (none = no accounts, the app is exactly as without them).  Alternatively put them in web/.env.production.  See deploy/README.md.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
# VITE_FIREBASE_APP_ID=

# ---- smoke_test.sh ---------------------------------------------------------------------------------------------
# API_URL as above (or pass it as the first argument)
# SMOKE_ORIGIN=https://your-github-user.github.io   # optional: also checks the CORS preflight for this origin (and that a foreign origin is refused)
EXPECT_CLASSES=12
