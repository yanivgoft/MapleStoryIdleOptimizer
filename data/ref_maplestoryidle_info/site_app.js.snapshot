      "Shadow Surge": "https://media.maplestorywiki.net/yetidb/Skill_Shadow_Surge.png",
      "Alchemic Adrenaline": "https://media.maplestorywiki.net/yetidb/Skill_Alchemic_Adrenaline.png",
      "Quad Star": "https://media.maplestorywiki.net/yetidb/Skill_Quad_Star_%28Night_Lord%29.png",
    },
    shadower: {
      "Agile Daggers": "https://media.maplestorywiki.net/yetidb/Skill_Agile_Daggers.png",
      "Channel Karma": "https://media.maplestorywiki.net/yetidb/Skill_Channel_Karma.png",
    },
  };
  const override = classIconOverrides[jobId]?.[skill.name];

  return override
    ? override.startsWith("http")
      ? override
      : `https://media.maplestorywiki.net/maplestoryidle/${override}`
    : skill.iconUrl || wikiImage(`Skill_${skill.name.replaceAll(" ", "_")}.png`);
}

function getMasteryIcon(masteryName) {
  const exactIcons = {
    "Main Stat Enhancement": yetiImage("Skill_Physical_Training.png"),
    "Critical Rate Enhancement": yetiImage("Skill_Critical_Shot.png"),
    "Basic Attack Damage Enhancement": "./assets/mastery-basic-attack-damage.png",
    "Accuracy Enhancement": yetiImage("Skill_Marksmanship.png"),
    "Sharp Eyes - Persistence": wikiImage("Skill_Sharp_Eyes.png"),
    "Illusion Step - Enhance": wikiImage("Skill_Illusion_Step.png"),
  };

  const sharedDamageIcon = "./assets/mastery-skill-damage.png";

  if (exactIcons[masteryName]) {
    return exactIcons[masteryName];
  }

  if (
    masteryName.includes("Max Damage Multiplier") ||
    masteryName.includes("Basic Attack Target") ||
    masteryName.includes("Skill Damage")
  ) {
    return sharedDamageIcon;
  }

  return yetiImage("Skill_Physical_Training.png");
}

function renderJobButtons() {
  jobButtons.innerHTML = jobs
    .map(
      (job) => `
        <button class="job-button ${job.id === state.selectedJobId ? "is-active" : ""}" data-job-id="${job.id}">
          <span class="job-icon">${
            job.iconUrl
              ? `<img src="${job.iconUrl}" alt="" loading="lazy" />`
              : job.icon
          }</span>
          <span class="job-meta">
            <strong>${job.name}</strong>
            <span>${job.family}</span>
          </span>
        </button>
      `,
    )
    .join("");

  jobButtons.querySelectorAll("button").forEach((button) => {
    button.addEventListener("click", () => {
      state.selectedJobId = button.dataset.jobId;
      state.advancement = "all";
      render();
      scrollSkillViewToTop();
    });
  });
}

function getFilteredSkills(job, { applyType = true } = {}) {
  return job.skills.filter((skill) => {
    const matchesType = !applyType || state.type === "all" || skill.type === state.type;
    const matchesAdvancement = state.advancement === "all" || skill.job === state.advancement;
    const haystack = `${skill.name} ${skill.description} ${skill.reqLevel ?? ""}`.toLowerCase();
    const matchesSearch = !state.search || haystack.includes(state.search);
    return matchesType && matchesAdvancement && matchesSearch;
  });
}

function render() {
  const job = jobs.find((item) => item.id === state.selectedJobId) ?? jobs[0];
  const isTimelineView = state.view === "timeline";
  const filteredSkills = getFilteredSkills(job, { applyType: !isTimelineView });

  document.querySelector("#classFamily").textContent = job.family;
  document.querySelector("#className").textContent = job.name;
  document.querySelector("#classDescription").textContent = job.description;
  renderHeroArtwork(job);
  document.querySelector("#skillCount").textContent = filteredSkills.length;
  document.querySelector("#activeCount").textContent = filteredSkills.filter(
    (skill) => skill.type === "Active",
  ).length;
  document.querySelector("#passiveCount").textContent = filteredSkills.filter(
    (skill) => skill.type === "Passive",
  ).length;
  document.querySelector("#maxReqLevel").textContent =
    Math.max(0, ...job.skills.map((skill) => skill.reqLevel ?? 1)) || "-";

  document.querySelector("#emptyState").hidden = job.skills.length > 0;
  renderClassMasteries(job.classMasteries ?? [], !isTimelineView);
  renderAdvancementTabs(job);
  renderViewModeTabs(job);
  skillGroups.hidden = isTimelineView;
  timelineTrack.hidden = !isTimelineView;
  if (isTimelineView) {
    timelineTrack.innerHTML = renderUnlockTimeline(job);
    skillGroups.innerHTML = "";
  } else {
    skillGroups.innerHTML = renderSkillGroups(filteredSkills);
    timelineTrack.innerHTML = "";
  }
  renderJobButtons();
}

function renderHeroArtwork(job) {
  const heroArtwork = document.querySelector("#heroArtwork");

  if (!heroArtwork) {
    return;
  }

  const hasArtwork = Boolean(job.iconUrl);
  const heroPanel = heroArtwork.closest(".hero-panel");
  const hero = heroPanel?.closest(".hero");

  heroArtwork.src = job.iconUrl || "";
  heroArtwork.alt = `${job.name} class artwork`;
  heroArtwork.hidden = !hasArtwork;
  heroPanel?.classList.toggle("is-empty", !hasArtwork);
  hero?.classList.toggle("is-artwork-empty", !hasArtwork);
}

function renderAdvancementTabs(job) {
  const tabs = ["all", ...new Set(job.skills.map((skill) => skill.job))];
  advancementTabs.innerHTML = tabs
    .map((tab) => {
      const isActive = state.advancement === tab;
      const label = tab === "all" ? "All" : tab.replace(" Job", "");
      return `<button class="job-tab ${isActive ? "is-active" : ""}" data-advancement="${tab}" type="button">${label}</button>`;
    })
    .join("");

  advancementTabs.hidden = job.skills.length === 0;
  advancementTabs.querySelectorAll("button").forEach((button) => {
    button.addEventListener("click", () => {
      state.advancement = button.dataset.advancement;
      render();
      scrollSkillViewToTop();
    });
  });
}

function renderViewModeTabs(job) {
  const isTimelineView = state.view === "timeline";

  viewModeTabs.querySelectorAll("button").forEach((button) => {
    const isActive = button.dataset.view === state.view;
    button.classList.toggle("is-active", isActive);
    button.setAttribute("aria-selected", String(isActive));
  });

  if (typeFilterBox) {
    typeFilterBox.hidden = isTimelineView;
  }

  levelTrackControls.hidden = !isTimelineView || job.skills.length === 0;
  if (!isTimelineView) {
    return;
  }

  state.currentLevel = normalizeCurrentLevel(state.currentLevel);
  currentLevelInput.value = state.currentLevel;
}

function renderClassMasteries(masteries, isVisible = true) {
  const section = document.querySelector("#classMasterySection");
  const container = document.querySelector("#classMasteries");
  const count = document.querySelector("#classMasteryCount");

  section.querySelector(".class-mastery-note")?.remove();
  section.hidden = !isVisible || masteries.length === 0;
  count.textContent = `${masteries.length} upgrades`;
  container.innerHTML = masteries
    .map(
      (item) => `
        <article class="class-mastery-card">
          <img src="${getMasteryIcon(item.name)}" alt="" loading="lazy" />
          <div>
            <span>Lv ${item.reqLevel}</span>
            <strong>${item.name}</strong>
            <p>${item.description}</p>
          </div>
        </article>
      `,
    )
    .join("");

  if (isVisible && masteries.length) {
    container.insertAdjacentHTML(
      "afterend",
      '<p class="class-mastery-note">Mastery upgrades are fixed unlock bonuses. Skill Lv. scaling is shown inside each skill\'s Skill Enhancement table.</p>',
    );
  }
}

function renderSkillGroups(skills) {
  if (!skills.length) {
    return "";
  }

  const groups = groupBy(skills, "job");
  return Object.entries(groups)
    .sort(([jobA], [jobB]) => getJobOrder(jobA) - getJobOrder(jobB))
    .map(
      ([jobName, jobSkills]) => `
        <section class="job-group">
          <h3>${jobName}</h3>
          <div class="skill-grid">
            ${sortSkillsByLevel(jobSkills)
              .map((skill) => renderSkillCard(skill, state.selectedJobId))
              .join("")}
          </div>
        </section>
      `,
    )
    .join("");
}

function renderUnlockTimeline(job) {
  const currentLevel = normalizeCurrentLevel(state.currentLevel);
  const events = buildUnlockEvents(job).filter((event) => unlockEventMatchesFilters(event));
  const nextEvent = events.find((event) => event.level > currentLevel);
  const nextLevel = nextEvent?.level ?? null;

  renderNextUnlockSummary(events, nextLevel, currentLevel);

  if (!events.length) {
    return `
      <div class="empty-state">
        <h3>No unlocks match the current filters</h3>
        <p>Clear the search or switch the advancement tab to see the full level track.</p>
      </div>
    `;
  }

  return Object.entries(groupBy(events, "job"))
    .sort(([jobA], [jobB]) => getJobOrder(jobA) - getJobOrder(jobB))
    .map(
      ([jobName, jobEvents]) => `
        <section class="unlock-stage">
          <h3>${jobName}</h3>
          <div class="unlock-event-list">
            ${jobEvents
              .map((event) => renderUnlockEvent(event, currentLevel, nextLevel))
              .join("")}
          </div>
        </section>
      `,
    )
    .join("");
}

function buildUnlockEvents(job) {
  const events = [];
  const impactJob = jobSkillImpactByJob.get(job.id);
  const skillRows = impactJob?.skills?.length ? impactJob.skills : job.skills;

  (skillRows || []).forEach((skill) => {
    const displaySkill = skill.displayName ? findDisplaySkillForImpact(job, skill) : skill;
    const level = impactJob ? skill.requiredLevel ?? displaySkill?.reqLevel ?? 1 : skill.reqLevel ?? 1;
    const details = splitSkillDescription(skill.description || displaySkill?.description || "");
    const name = skill.displayName || skill.name;
    const type = skill.type || displaySkill?.type || "Skill";
    events.push({
      kind: "skill",
      kindLabel: "Skill",
      level,
      job: skill.jobLabel || displaySkill?.job || jobStepForLevel(level),
      title: name,
      type,
      description: details.description,
      notes: details.notes,
      sourceLabel: "Unlock",
      iconUrl:
        skill.iconUrl || (displaySkill && !displaySkill.noIconFallback ? getSkillIcon(displaySkill, job.id) : ""),
    });
  });

  (job.skills || []).forEach((skill) => {
    (skill.masteries || []).forEach((item) => {
      const masteryLevel = item.reqLevel ?? skill.reqLevel ?? 1;
      const masteryDetails = splitSkillDescription(item.description || "");
      events.push({
        kind: "skill-mastery",
        kindLabel: "Skill Mastery",
        level: masteryLevel,
        job: jobStepForLevel(masteryLevel),
        title: item.name,
        type: "Mastery",
        description: masteryDetails.description,
        notes: masteryDetails.notes,
        sourceLabel: skill.name,
        iconUrl: getSkillIcon(skill, job.id),
      });
    });
  });

  (job.classMasteries || []).forEach((item) => {
    const level = item.reqLevel ?? 1;
    const details = splitSkillDescription(item.description || "");
    events.push({
      kind: "job-mastery",
      kindLabel: "Job Mastery",
      level,
      job: jobStepForLevel(level),
      title: item.name,
      type: "Mastery",
      description: details.description,
      notes: details.notes,
      sourceLabel: "Job Mastery",
      iconUrl: getMasteryIcon(item.name),
    });
  });

  return events.sort((eventA, eventB) => {
    if (eventA.level !== eventB.level) {
      return eventA.level - eventB.level;
    }

    const kindOrder = { skill: 0, "job-mastery": 1, "skill-mastery": 2 };
    const kindA = kindOrder[eventA.kind] ?? 3;
    const kindB = kindOrder[eventB.kind] ?? 3;
    if (kindA !== kindB) {
      return kindA - kindB;
    }

    return eventA.title.localeCompare(eventB.title);
  });
}

function findDisplaySkillForImpact(job, impactSkill) {
  const impactName = normalizeSkillLookup(impactSkill.displayName || "");
  const impactLevel = impactSkill.requiredLevel ?? null;
  return (
    (job.skills || []).find(
      (skill) => normalizeSkillLookup(skill.name) === impactName && (skill.reqLevel ?? null) === impactLevel,
    ) ||
    (job.skills || []).find((skill) => normalizeSkillLookup(skill.name) === impactName) ||
    null
  );
}

function unlockEventMatchesFilters(event) {
  const matchesAdvancement = state.advancement === "all" || event.job === state.advancement;
  const haystack = `${event.title} ${event.description} ${event.level} ${event.type} ${event.kindLabel} ${event.sourceLabel}`.toLowerCase();
  const matchesSearch = !state.search || haystack.includes(state.search);
  return matchesAdvancement && matchesSearch;
}

function renderNextUnlockSummary(events, nextLevel, currentLevel) {
  if (!events.length) {
    nextUnlockSummary.innerHTML = `
      <span>Next unlock</span>
      <strong>No matching unlocks</strong>
      <small>Clear filters to show the track.</small>
    `;
    return;
  }

  if (!nextLevel) {
    nextUnlockSummary.innerHTML = `
      <span>Track complete</span>
      <strong>All matching unlocks are at or below Lv ${currentLevel}</strong>
      <small>${events.length} unlock event${events.length === 1 ? "" : "s"} shown.</small>
    `;
    return;
  }

  const nextEvents = events.filter((event) => event.level === nextLevel);
  const distance = nextLevel - currentLevel;
  const title = nextEvents.length === 1 ? nextEvents[0].title : `${nextEvents.length} unlocks at Lv ${nextLevel}`;
  const preview = nextEvents
    .slice(0, 3)
    .map((event) => event.title)
    .join(", ");

  nextUnlockSummary.innerHTML = `
    <span>Next unlock</span>
    <strong>Lv ${nextLevel}: ${title}</strong>
    <small>${distance} level${distance === 1 ? "" : "s"} away${nextEvents.length > 1 ? ` - ${preview}` : ""}.</small>
  `;
}

function renderUnlockEvent(event, currentLevel, nextLevel) {
  const isUnlocked = event.level <= currentLevel;
  const isNext = nextLevel !== null && event.level === nextLevel;
  const typeClass = event.type.toLowerCase();
  const description = summarizeUnlockDescription(event.description);
  const status = isUnlocked ? "Unlocked" : isNext ? "Next" : `${event.level - currentLevel} levels away`;

  return `
    <article class="unlock-event ${isUnlocked ? "is-unlocked" : ""} ${isNext ? "is-next" : ""}">
      <div class="unlock-level">
        <span>Lv</span>
        <strong>${event.level}</strong>
      </div>
      <span class="skill-icon unlock-icon">
        ${
          event.iconUrl
            ? `<img src="${event.iconUrl}" alt="" loading="lazy" onerror="this.remove(); this.parentElement.textContent='${event.title.slice(0, 2).toUpperCase()}'" />`
            : event.title.slice(0, 2).toUpperCase()
        }
      </span>
      <div class="unlock-copy">
        <div class="unlock-meta">
          <span class="tag ${typeClass}">${event.type}</span>
          <span class="tag level">${event.kindLabel}</span>
          <span class="unlock-status">${status}</span>
        </div>
        <h4>${event.title}</h4>
        ${event.sourceLabel && event.sourceLabel !== "Unlock" ? `<span class="unlock-source">${event.sourceLabel}</span>` : ""}
        ${event.notes.length ? renderNoteList(event.notes) : ""}
        ${description ? `<p>${formatText(description)}</p>` : ""}
      </div>
    </article>
  `;
}

function summarizeUnlockDescription(description) {
  const text = formatText(description || "");
  if (text.length <= 180) {
    return text;
  }
  return `${text.slice(0, 177).trim()}...`;
}

function jobStepForLevel(level) {
  const parsed = Number(level) || 1;
  if (parsed >= 100) return "4th Job";
  if (parsed >= 60) return "3rd Job";
  if (parsed >= 30) return "2nd Job";
  return "1st Job";
}

function normalizeCurrentLevel(value) {
  const parsed = Math.floor(Number(value));
  return Number.isFinite(parsed) && parsed > 0 ? parsed : 1;
}

function getJobOrder(jobName) {
  return ["1st Job", "2nd Job", "3rd Job", "4th Job"].indexOf(jobName);
}

function sortSkillsByLevel(skills) {
  return [...skills].sort((skillA, skillB) => {
    const levelA = skillA.reqLevel ?? 1;
    const levelB = skillB.reqLevel ?? 1;

    if (levelA !== levelB) {
      return levelA - levelB;
    }

    return skillA.name.localeCompare(skillB.name);
  });
}

function renderSkillCard(skill, jobId) {
  const typeClass = skill.type.toLowerCase();
  const facts = buildSkillFacts(skill);
  const iconUrl = skill.iconUrl || (skill.noIconFallback ? "" : getSkillIcon(skill, jobId));
  const animationUrl = getSkillAnimation(skill, jobId);
  const details = splitSkillDescription(skill.description);
  const levelImpact = getSkillImpactForCard(skill, jobId);
  return `
    <article class="skill-card">
      <header>
        <span class="skill-icon">
          ${
            iconUrl
              ? `<img src="${iconUrl}" alt="" loading="lazy" onerror="this.remove(); this.parentElement.textContent='${skill.name.slice(0, 2).toUpperCase()}'" />`
              : skill.name.slice(0, 2).toUpperCase()
          }
        </span>
        <div>
          <h4>${skill.name}</h4>
          <div class="skill-tags">
            <span class="tag ${typeClass}">${skill.type}</span>
            <span class="tag level">Lv ${skill.reqLevel ?? 1}</span>
          </div>
        </div>
      </header>
      ${
        facts.length
          ? `<dl class="skill-facts">${facts
              .map((fact) => `<div><dt>${fact.label}</dt><dd>${formatText(String(fact.value))}</dd></div>`)
              .join("")}</dl>`
          : ""
      }
      ${renderSkillLevelImpact(levelImpact, skill)}
      ${
        details.notes.length
          ? renderNoteList(details.notes)
          : ""
      }
      ${details.description ? `<p>${formatText(details.description)}</p>` : ""}
      ${animationUrl ? renderSkillAnimation(skill, animationUrl) : ""}
      ${renderProgression(skill)}
    </article>
  `;
}

function getSkillAnimation(skill, jobId) {
  return grandisSkillAnimations[jobId]?.[skill.name] || skill.animationUrl || "";
}

function renderSkillAnimation(skill, animationUrl) {
  return `
    <details class="skill-animation">
      <summary>Animation preview</summary>
      <img src="${animationUrl}" alt="${skill.name} animation preview" loading="lazy" />
    </details>
  `;
}

function normalizeSkillLookup(value = "") {
  return String(value).toLowerCase().replace(/[^a-z0-9]/g, "");
}

function getSkillImpactForCard(skill, jobId) {
  const job = jobSkillImpactByJob.get(jobId);
  if (!job || !skill) return null;
  const skillName = normalizeSkillLookup(skill.name);
  const requiredLevel = skill.reqLevel ?? null;
  return (
    (job.skills || []).find(
      (item) => normalizeSkillLookup(item.displayName) === skillName && (item.requiredLevel ?? null) === requiredLevel,
    ) ||
    (job.skills || []).find((item) => normalizeSkillLookup(item.displayName) === skillName) ||
    null
  );
}

function renderSkillLevelImpact(impact, skill = null) {
  if (!impact || !impact.scalingSummary) return "";
  const directRows = (impact.directOps || []).filter((op) => hasSkillLevelFactor(op));
  const statRows = (impact.statOps || []).filter((op) => hasSkillLevelFactor(op));
  if (!directRows.length && !statRows.length) return "";
  const summary = buildSkillScalingSummary(directRows, statRows, impact);

  return `
    <details class="skill-level-impact">
      <summary>
        <span>Skill enhancement</span>
        <strong>${formatText(summary)}</strong>
      </summary>
      <div class="skill-level-impact-body">
        ${renderSkillEnhancementTable(directRows, statRows, skill)}
        ${
          impact.otherOperationCount
            ? `<p class="skill-level-impact-note">${impact.otherOperationCount} extra table effect${impact.otherOperationCount === 1 ? "" : "s"} exist for this skill. This reference only expands rows with readable skill-level scaling.</p>`
            : ""
        }
      </div>
    </details>
  `;
}

function buildSkillScalingSummary(directRows, statRows, impact) {
  const parts = [];
  const statTypes = [...new Set(statRows.map((op) => statTypeLabel(op.statType)))].slice(0, 3);

  if (directRows.length) {
    parts.push(directRows.length === 1 ? "Damage" : `${directRows.length} damage rows`);
  }

  if (statTypes.length) {
    parts.push(statTypes.join(", "));
  }

  return parts.join(" | ") || impact.scalingSummary || "Level values";
}

function renderSkillEnhancementTable(directRows, statRows, skill = null) {
  const rows = SKILL_LEVEL_PREVIEW_LEVELS.map((level) => ({
    level,
    description: buildSkillEnhancementDescription(level, directRows, statRows, skill),
  })).filter((row) => row.description);

  return `
    <div class="skill-enhancement-table" role="table" aria-label="Skill enhancement values">
      <div class="skill-enhancement-head" role="row">
        <span role="columnheader">Level</span>
        <span role="columnheader">Effect at this skill level</span>
      </div>
      ${rows
        .map(
          (row) => `
            <div class="skill-enhancement-row" role="row">
              <strong role="cell">Lv ${row.level}</strong>
              <span role="cell">${row.description}</span>
            </div>
          `,
        )
        .join("")}
    </div>
  `;
}

function buildSkillEnhancementDescription(level, directRows, statRows, skill = null) {
  const parts = [];
  const prefix = skillEnhancementPrefix(skill);

  directRows.forEach((op, index) => {
    const value = scaledSkillRawValue(op.ratioE3, skillOpFactorIndex(op), level);
    if (!Number.isFinite(value)) return;
    const label = directRows.length > 1 ? `Damage ${index + 1}: ` : "";
    parts.push(`${label}Deals <b>${formatScaledSkillValue(op, value, "damage")}</b> damage${formatHitSuffix(op)}.`);
  });

  const statParts = statRows.map((op) => {
    const value = scaledSkillRawValue(op.value, skillOpFactorIndex(op), level);
    if (!Number.isFinite(value)) return "";
    return `${statTypeLabel(op.statType)} <b>${formatSignedSkillValue(op, value)}</b>`;
  }).filter(Boolean);

  if (statParts.length) {
    parts.push(`${statParts.join(" | ")}${statRows.some((op) => op.uptimeRatio && op.uptimeRatio < 1) ? " while the buff is active" : ""}.`);
  }

  return [prefix, parts.join(" ")].filter(Boolean).join(" ");
}

function formatBaseDamageValue(op) {
  if (Number.isFinite(op.damagePercent)) {
    return `Base ${formatNumber(op.damagePercent, 1)}%`;
  }
  return "Table formula";
}

function formatHitText(op) {
  const hits = Number.isFinite(op.hitCount) && op.hitCount > 0 ? `${op.hitCount} hit${op.hitCount === 1 ? "" : "s"}` : "";
  const maxHits = Number.isFinite(op.maxHitCount) && op.maxHitCount > 0 ? `up to ${op.maxHitCount}` : "";
  return [hits, maxHits].filter(Boolean).join(" | ") || "Per damage table row";
}

function formatStatTableValue(op) {
  if (Number.isFinite(op.valuePercent)) {
    return `Base ${formatNumber(op.valuePercent, 1)}%`;
  }
  if (Number.isFinite(op.value)) {
    return `Base ${formatNumber(op.value, 1)}`;
  }
  return "Table value";
}

function hasSkillLevelFactor(op) {
  return skillOpFactorIndex(op) > 0;
}

function skillOpFactorIndex(op) {
  const parsed = Number(op?.factorIndex);
  return Number.isFinite(parsed) && parsed > 0 ? parsed : 0;
}

function skillLevelFactorAt(level, factorIndex) {
  const index = Number(factorIndex);
  if (!Number.isFinite(index) || index <= 0) return 1000;
  const maxLevel = Number(jobSkillImpactData?.skillLevelFactors?.maxLevel) || 1000;
  const clamped = Math.max(1, Math.min(Math.round(Number(level) || 1), maxLevel));
  const column = jobSkillImpactData?.skillLevelFactors?.columns?.[String(index)];
  const tableValue = Number(column?.[clamped]);
  if (Number.isFinite(tableValue) && tableValue > 0) return tableValue;
  if (index === 12) return clamped <= 1 ? 1000 : 1000 + clamped * 5;
  if (index === 21) return clamped <= 1 ? 1000 : 1000 + clamped * 4;
  if (index === 22) return clamped <= 1 ? 1000 : 1000 + clamped * 3;
  if (index === 23) return clamped <= 1 ? 1000 : 1000 + clamped * 15;
  return 1000;
}

function scaledSkillRawValue(baseValue, factorIndex, skillLevel) {
  const parsed = Number(baseValue);
  if (!Number.isFinite(parsed)) return null;
  return Math.floor((parsed * skillLevelFactorAt(skillLevel, factorIndex)) / 1000);
}

function formatScaledSkillValue(op, raw, mode) {
  if (!Number.isFinite(raw)) return "-";
  if (mode === "damage") {
    return `${formatNumber(raw / 10, 1)}%`;
  }
  if (op?.unit === "percentE1") {
    return `${formatNumber(raw / 10, 1)}%`;
  }
  return formatNumber(raw, 1);
}

function formatSignedSkillValue(op, raw) {
  const formatted = formatScaledSkillValue(op, raw, "stat");
  if (formatted === "-") return formatted;
  const parsed = Number(raw);
  return parsed > 0 ? `+${formatted}` : formatted;
}

function skillEnhancementPrefix(skill) {
  const description = String(skill?.description || "");
  const match = description.match(/^\[([^\]]+)\]/);
  return match ? `[${match[1]}]` : "";
}

function formatHitSuffix(op) {
  const hits = Number(op?.hitCount);
  const targets = Number(op?.maxHitCount);
  const hasHits = Number.isFinite(hits) && hits > 1;
  const hasTargets = Number.isFinite(targets) && targets > 1;
  if (hasHits && hasTargets) return ` over ${hits} hits, up to ${targets} targets`;
  if (hasHits) return ` over ${hits} hits`;
  if (hasTargets) return ` against up to ${targets} targets`;
  return "";
}

function formatSignedNumber(value, decimals = 1) {
  const formatted = formatNumber(Math.abs(value), decimals);
  return `${value >= 0 ? "+" : "-"}${formatted}`;
}

function formatNumber(value, decimals = 1) {
  if (!Number.isFinite(value)) return "-";
  return Number(value).toLocaleString(undefined, {
    maximumFractionDigits: decimals,
    minimumFractionDigits: value % 1 === 0 ? 0 : Math.min(decimals, 1),
  });
}

function formatUptimeText(op) {
  if (op.uptimeRatio === 1) return "Always on in the table";
  if (Number.isFinite(op.uptimeRatio) && op.uptimeRatio > 0) {
    return `Approx. ${(op.uptimeRatio * 100).toFixed(1)}% uptime before rotation checks`;
  }
  if (Number.isFinite(op.durationMs) && op.durationMs > 0) {
    return `${Math.round(op.durationMs / 1000)} sec duration`;
  }
  return "Conditional table row";
}

function statTypeLabel(statType = "") {
  const labels = {
    AttackSpeed: "Attack Speed",
    CriticalChance: "Crit Rate",
    CriticalPower: "Crit Damage",
    FinalDamage: "Final Damage",
    SkillPower: "Skill Damage",
    BaseAttackPower: "Basic Attack Damage",
    MinDamageRatio: "Min Damage",
    MaxDamageRatio: "Max Damage",
    PiercePower: "Defense Pen",
    AttackPower: "Damage",
    AttackPowerToBoss: "Boss Damage",
    AttackPowerExcludeBoss: "Normal Damage",
    Weakness: "Weakness",
    Attack: "Attack",
    Defence: "Defense",
    MaxHp: "Max HP",
    RunSpeedMms: "Move Speed",
    BuffDurationRatio: "Buff Duration",
    Toughness: "Damage Taken",
    AvoidChance: "Evasion",
    DebuffResist: "Debuff Resist",
    MpConsumeRatio: "MP Consumed",
    CriticalResist: "Crit Resist",
    AttackPowerInCc: "Status Damage",
    Jobstep3SkillLevel: "3rd Job Skill Lv.",
    Jobstep4SkillLevel: "4th Job Skill Lv.",
    Str: "STR",
    Dex: "DEX",
    Int: "INT",
    Luk: "LUK",
  };
  return labels[statType] || statType || "Stat";
}

function splitSkillDescription(description) {
  const notes = [];
  let remaining = description.trim();
  let match = remaining.match(/^\[([^\]]+)\]\s*/);

  while (match) {
    notes.push({
      text: match[1],
      type: getNoteType(match[1]),
    });
    remaining = remaining.slice(match[0].length).trim();
    match = remaining.match(/^\[([^\]]+)\]\s*/);
  }

  return { notes, description: remaining };
}

function getNoteType(note) {
  return /required|must|in slot/i.test(note) ? "requirement" : "effect";
}

function renderNoteList(notes) {
  return `<ul class="effect-list">${notes
    .map((note) => `<li class="${note.type}">${note.text}</li>`)
    .join("")}</ul>`;
}

function formatText(text) {
  return text
    .replace(/\\n/g, " ")
    .replace(/\{#expr:[^}]+\}/g, "scaling")
    .trim();
}

function renderProgression(skill) {
  const hasEnhancements = skill.enhancements?.length;
  const hasMasteries = skill.masteries?.length;

  if (!hasEnhancements && !hasMasteries) {
    return "";
  }

  return `
    <div class="progression">
      ${
        hasEnhancements
          ? `<details>
              <summary>Skill enhancement</summary>
              <div class="enhancement-list">
                ${skill.enhancements
                  .map(
                    (item) => `
                      <div>
                        <span>Lv ${item.level}</span>
                        <p>${formatText(item.description)}</p>
                      </div>
                    `,
                  )
                  .join("")}
              </div>
            </details>`
          : ""
      }
      ${
        hasMasteries
          ? `<div class="mastery-list">
              <h5>Mastery upgrades</h5>
              ${skill.masteries
                .map((item) => {
                  const details = splitSkillDescription(item.description);
                  return `
                    <div>
                      <strong>${item.name}</strong>
                      <span>Req. Lv ${item.reqLevel}</span>
                      ${details.notes.length ? renderNoteList(details.notes) : ""}
                      <p>${formatText(details.description)}</p>
                    </div>
                  `;
                })
                .join("")}
            </div>`
          : ""
      }
    </div>
  `;
}

function buildSkillFacts(skill) {
  return [
    ["Cooldown", skill.cooldown],
    ["MP", skill.mpCost],
    ["Damage", skill.damage],
    ["Hits", skill.hits],
    ["Targets", skill.targets],
    ["Duration", skill.duration],
  ]
    .filter(([, value]) => value !== undefined && value !== "")
    .map(([label, value]) => ({ label, value }));
}

function groupBy(items, key) {
  return items.reduce((groups, item) => {
    groups[item[key]] ??= [];
    groups[item[key]].push(item);
    return groups;
  }, {});
}

loadJobSkillImpact();
render();
