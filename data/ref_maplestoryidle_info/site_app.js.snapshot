function applyAugust13SkillUpdates() {
  jobs.forEach((job) => {
    const updates = AUGUST_13_SKILL_UPDATES[job.id];
    if (!updates) return;
    (job.skills || []).forEach((skill) => {
      const update = updates[skill.name];
      if (!update) return;
      if (update.description) skill.description = update.description;
      if (update.cooldown) skill.cooldown = update.cooldown;
      (update.masteries || []).forEach((masteryUpdate) => {
        const target = (skill.masteries || []).find(
          (item) => item.name === masteryUpdate.name &&
            (masteryUpdate.reqLevel === undefined || item.reqLevel === masteryUpdate.reqLevel),
        );
        if (target && masteryUpdate.description) target.description = masteryUpdate.description;
      });
    });
  });
}

applyAugust13SkillUpdates();

const requestedJobId =
  typeof window !== "undefined" && window.location?.search
    ? new URLSearchParams(window.location.search).get("job")
    : "";

const state = {
  selectedJobId: requestedJobId || "dark-knight",
  search: "",
  type: "all",
  advancement: "all",
  view: "skills",
  currentLevel: 1,
};

let jobSkillImpactData = null;
const jobSkillImpactByJob = new Map();
const SKILL_LEVEL_PREVIEW_LEVELS = [1, 30, 70, 150, 300, 500];

const jobButtons = document.querySelector("#jobButtons");
const advancementTabs = document.querySelector("#advancementTabs");
const viewModeTabs = document.querySelector("#viewModeTabs");
const levelTrackControls = document.querySelector("#levelTrackControls");
const currentLevelInput = document.querySelector("#currentLevelInput");
const nextUnlockSummary = document.querySelector("#nextUnlockSummary");
const timelineTrack = document.querySelector("#timelineTrack");
const skillGroups = document.querySelector("#skillGroups");
const searchInput = document.querySelector("#searchInput");
const typeFilter = document.querySelector("#typeFilter");
const typeFilterBox = typeof typeFilter?.closest === "function" ? typeFilter.closest(".select-box") : null;

searchInput.addEventListener("input", (event) => {
  state.search = event.target.value.toLowerCase().trim();
  render();
});

typeFilter.addEventListener("change", (event) => {
  state.type = event.target.value;
  render();
  scrollSkillViewToTop();
});

viewModeTabs.querySelectorAll("button").forEach((button) => {
  button.addEventListener("click", () => {
    state.view = button.dataset.view || "skills";
    render();
    scrollSkillViewToTop();
  });
});

currentLevelInput.addEventListener("input", (event) => {
  state.currentLevel = normalizeCurrentLevel(event.target.value);
  render();
});

async function loadJobSkillImpact() {
  try {
    const response = await fetch("./assets/data/job-skill-impact.json", { cache: "no-store" });
    if (!response.ok) throw new Error(`Skill impact data failed with ${response.status}`);
    jobSkillImpactData = await response.json();
    jobSkillImpactByJob.clear();
    (jobSkillImpactData.jobs || []).forEach((job) => jobSkillImpactByJob.set(job.id, job));
    addGeneratedJobsFromImpact(jobSkillImpactData.jobs || []);
    applyGeneratedSkillDataToExistingJobs(jobSkillImpactData.jobs || []);
    render();
  } catch (error) {
    console.warn(error);
  }
}

function cleanGeneratedSkillDescription(value) {
  const text = String(value || "").trim();
  return /\{[^}]+\}/.test(text) ? "" : text;
}

function formatGeneratedCooldown(cooldownMs) {
  const seconds = Number(cooldownMs) / 1000;
  if (!Number.isFinite(seconds) || seconds <= 0) return "";
  const display = Number.isInteger(seconds) ? String(seconds) : seconds.toFixed(1).replace(/\.0$/, "");
  return `${display} sec`;
}

function addGeneratedJobsFromImpact(impactJobs = []) {
  impactJobs.forEach((impactJob) => {
    if (!impactJob?.generatedFromModel || !impactJob.id || jobs.some((job) => job.id === impactJob.id)) return;
    const skills = (impactJob.skills || []).map((skill) => ({
      job: skill.jobLabel === "Shared" ? "1st Job" : skill.jobLabel || "1st Job",
      name: skill.displayName || skill.tableName || `Skill ${skill.skillIndex}`,
      type: skill.type || "Active",
      reqLevel: skill.requiredLevel ?? 1,
      cooldown: formatGeneratedCooldown(skill.cooldownMs),
      description: cleanGeneratedSkillDescription(skill.description),
      iconUrl: skill.iconUrl || "",
      animationUrl: skill.animationUrl || "",
      noIconFallback: Boolean(skill.noIconFallback),
    }));
    if (!skills.length) return;
    jobs.push({
      id: impactJob.id,
      name: impactJob.name || impactJob.id,
      family: impactJob.family || "Job",
      icon: impactJob.icon || impactJob.name?.slice(0, 2).toUpperCase() || "?",
      iconUrl: impactJob.iconUrl || "",
      status: impactJob.status || "Live",
      description: cleanGeneratedSkillDescription(impactJob.description),
      source: impactJob.source || "",
      classMasteries: [],
      skills,
    });
  });
}

function applyGeneratedSkillDataToExistingJobs(impactJobs = []) {
  impactJobs.forEach((impactJob) => {
    const job = jobs.find((item) => item.id === impactJob.id);
    if (!job || impactJob.generatedFromModel) return;
    (impactJob.skills || []).forEach((impactSkill) => {
      const displaySkill = findDisplaySkillForImpact(job, impactSkill);
      if (!displaySkill) return;
      if (impactSkill.description) displaySkill.description = impactSkill.description;
      if (impactSkill.cooldownMs) displaySkill.cooldown = formatGeneratedCooldown(impactSkill.cooldownMs);
      if (impactSkill.requiredLevel) displaySkill.reqLevel = impactSkill.requiredLevel;
    });
  });
}

function scrollSkillViewToTop() {
  requestAnimationFrame(() => {
    document.querySelector(".skill-view").scrollIntoView({ block: "start" });
  });
}

function placeholderJob(id, name, family, icon) {
  return {
    id,
    name,
    family,
    icon,
    status: "Queued",
    description:
      "Skill data is queued for verification. The page shell is ready for active/passive skill entries.",
    skills: [],
  };
}

