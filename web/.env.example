# API base URL (default http://localhost:8000)
VITE_API_URL=http://localhost:8000
# 1 = no backend: serve the JSON fixtures in src/fixtures/ instead of calling the API
VITE_MOCK=0

# ---- Accounts (Google sign-in + cloud-saved profiles; optional) ----------------------------------------------------------------
# Leave all four EMPTY / unset and the app behaves exactly as without accounts (no sign-in button, no Firebase code loaded).
# They are the web app's PUBLIC identifiers from Firebase console -> Project settings -> Your apps -> Web app -> SDK config (not secrets;
# the security rules in deploy/firebase/firestore.rules protect the data).  All four are needed.  See web/README.md and deploy/README.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
